# "Sigma on Sigma" environment (staging, AWS US).
# Copy to .env.sigma-on-sigma (gitignored via .env.*) and fill in credentials, then
# select it per command/session with:  export SIGMA_ENV=sigma-on-sigma
# MCP endpoint for this env: ${SIGMA_BASE_URL}/mcp/v2
# Create client credentials in this org: Administration -> APIs and Tokens.
SIGMA_BASE_URL=https://api.staging.us.aws.sigmacomputing.io
SIGMA_CLIENT_ID=
SIGMA_CLIENT_SECRET=
